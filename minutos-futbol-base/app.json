{
  "expo": {
    "name": "Minutos Fútbol Base",
    "slug": "minutos-futbol-base",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "es.minutosfutbolbase.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Para elegir la foto de un jugador desde la galería."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "es.minutosfutbolbase.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Para elegir la foto de un jugador desde la galería.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2fbcd79e-bb2f-4c66-be02-870d721f8cc1"
      }
    },
    "owner": "tonyheredia"
  }
}
